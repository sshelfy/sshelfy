<Project Sdk="Microsoft.NET.Sdk">
  <!-- UI tests on Avalonia's headless platform: real views and controls, no window on screen. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- xUnit v3 (required by Avalonia.Headless.XUnit) runs tests as an executable. -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <!-- Same target as the app, which uses the Windows SDK when built on Windows. -->
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless.XUnit" Version="12.1.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Sshelfy.App\Sshelfy.App.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>