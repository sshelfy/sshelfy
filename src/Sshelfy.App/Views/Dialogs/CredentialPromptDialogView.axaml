<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dialogs="using:Sshelfy.App.ViewModels.Dialogs"
             xmlns:b="using:Sshelfy.App.Behaviors"
             x:Class="Sshelfy.App.Views.Dialogs.CredentialPromptDialogView"
             x:DataType="dialogs:CredentialPromptDialogViewModel">
    <StackPanel Margin="24,4,24,20" Spacing="14">
        <TextBlock Classes="error" Text="{Binding Message}" IsVisible="{Binding Message, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <StackPanel>
            <TextBlock Classes="label" Text="{Binding Label}" />
            <TextBox PasswordChar="•" Text="{Binding Password}" b:InputBehaviors.FocusOnAttach="True">
                <TextBox.KeyBindings>
                    <KeyBinding Gesture="Enter" Command="{Binding SubmitCommand}" />
                </TextBox.KeyBindings>
            </TextBox>
        </StackPanel>
        <CheckBox IsVisible="{Binding CanSave}" IsChecked="{Binding Save}">
            <TextBlock Text="Save in the encrypted vault" />
        </CheckBox>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Theme="{StaticResource SecondaryButton}" Content="Cancel" Command="{Binding CancelCommand}" />
            <Button Theme="{StaticResource PrimaryButton}" Content="{Binding ConfirmText}" Command="{Binding SubmitCommand}" />
        </StackPanel>
    </StackPanel>
</UserControl>
