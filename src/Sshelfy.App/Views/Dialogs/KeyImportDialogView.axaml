<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dialogs="using:Sshelfy.App.ViewModels.Dialogs"
             xmlns:c="using:Sshelfy.App.Controls"
             xmlns:b="using:Sshelfy.App.Behaviors"
             x:Class="Sshelfy.App.Views.Dialogs.KeyImportDialogView"
             x:DataType="dialogs:KeyImportDialogViewModel">
    <StackPanel Margin="24,8,24,20" Spacing="16">
        <TextBlock Classes="secondary" TextWrapping="Wrap"
                   Text="The key is validated and stored encrypted in the vault. OpenSSH, PEM and PuTTY (.ppk) formats are supported." />

        <StackPanel>
            <TextBlock Classes="label" Text="Name" />
            <TextBox Text="{Binding Name}" PlaceholderText="e.g. Work laptop" />
        </StackPanel>

        <StackPanel>
            <DockPanel Margin="0,0,0,6">
                <Button DockPanel.Dock="Right" Theme="{StaticResource GhostButton}" Padding="6,2" MinHeight="22"
                        Command="{Binding BrowseCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <c:Icon Size="13" Data="{StaticResource Icon.FolderOpen}" />
                        <TextBlock Classes="small" Text="Choose file…" />
                    </StackPanel>
                </Button>
                <TextBlock Classes="label" Margin="0" VerticalAlignment="Center" Text="Private key" />
            </DockPanel>
            <TextBox Text="{Binding KeyText}" AcceptsReturn="True" TextWrapping="NoWrap"
                     FontFamily="{StaticResource Font.Mono}" FontSize="{StaticResource FontSize.Small}"
                     Height="140" VerticalContentAlignment="Top"
                     PlaceholderText="-----BEGIN OPENSSH PRIVATE KEY-----"
                     b:InputBehaviors.FocusOnAttach="True" />
        </StackPanel>

        <StackPanel>
            <TextBlock Classes="label" Text="Passphrase" />
            <TextBox PasswordChar="•" Text="{Binding Passphrase}" PlaceholderText="Only if the key is encrypted" />
        </StackPanel>

        <TextBlock Classes="error" Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Theme="{StaticResource SecondaryButton}" Content="Cancel" Command="{Binding CancelCommand}" />
            <Button Theme="{StaticResource PrimaryButton}" Content="Import" Command="{Binding ImportCommand}" />
        </StackPanel>
    </StackPanel>
</UserControl>
