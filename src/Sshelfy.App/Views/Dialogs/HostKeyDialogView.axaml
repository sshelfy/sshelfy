<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dialogs="using:Sshelfy.App.ViewModels.Dialogs"
             xmlns:c="using:Sshelfy.App.Controls"
             xmlns:b="using:Sshelfy.App.Behaviors"
             x:Class="Sshelfy.App.Views.Dialogs.HostKeyDialogView"
             x:DataType="dialogs:HostKeyDialogViewModel">
    <StackPanel Margin="24,4,24,20" Spacing="16">
        <TextBlock Classes="secondary" TextWrapping="Wrap" Text="{Binding Message}" />

        <Border Background="{DynamicResource Brush.SurfaceSunken}" CornerRadius="{StaticResource Radius.Md}" Padding="12,10">
            <StackPanel Spacing="8">
                <DockPanel>
                    <TextBlock Classes="caption" Width="96" Text="Key type" />
                    <TextBlock Classes="mono small" Text="{Binding Challenge.Algorithm}" />
                </DockPanel>
                <DockPanel>
                    <TextBlock Classes="caption" Width="96" Text="Fingerprint" />
                    <SelectableTextBlock FontFamily="{StaticResource Font.Mono}" FontSize="{StaticResource FontSize.Small}"
                                         TextWrapping="Wrap" Text="{Binding Challenge.Fingerprint}" />
                </DockPanel>
                <DockPanel IsVisible="{Binding IsChanged}">
                    <TextBlock Classes="caption" Width="96" Text="Previously" />
                    <TextBlock Classes="mono small tertiary" TextWrapping="Wrap" Text="{Binding Challenge.PreviousFingerprint}" />
                </DockPanel>
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Theme="{StaticResource SecondaryButton}" Content="Cancel" Command="{Binding CancelCommand}"
                    b:InputBehaviors.FocusOnAttach="True" />
            <Panel>
                <Button Theme="{StaticResource DangerButton}" IsVisible="{Binding IsChanged}"
                        Content="{Binding ConfirmText}" Command="{Binding TrustCommand}" />
                <Button Theme="{StaticResource PrimaryButton}" IsVisible="{Binding !IsChanged}"
                        Content="{Binding ConfirmText}" Command="{Binding TrustCommand}" />
            </Panel>
        </StackPanel>
    </StackPanel>
</UserControl>
