<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Sshelfy.App.ViewModels"
        xmlns:tabs="using:Sshelfy.App.ViewModels.Tabs"
        xmlns:sidebar="using:Sshelfy.App.ViewModels.Sidebar"
        xmlns:dialogs="using:Sshelfy.App.ViewModels.Dialogs"
        xmlns:tun="using:Sshelfy.App.ViewModels.Tunnels"
        xmlns:c="using:Sshelfy.App.Controls"
        xmlns:conv="using:Sshelfy.App.Converters"
        xmlns:b="using:Sshelfy.App.Behaviors"
        xmlns:terminal="using:Sshelfy.Core.Terminal"
        xmlns:settings="using:Sshelfy.Core.Settings"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="Sshelfy.App.Views.ShellWindow"
        x:DataType="vm:ShellViewModel"
        Title="{Binding WindowTitle}"
        Width="1280" Height="800"
        MinWidth="820" MinHeight="520"
        Icon="avares://sshelfy/Assets/sshelfy.ico"
        b:CloseGuard.Guard="{Binding}"
        WindowStartupLocation="CenterScreen">

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+Shift+B" Command="{Binding ToggleSidebarCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+J" Command="{Binding ToggleBottomPanelCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+F" Command="{Binding FindInTerminalCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+P" Command="{Binding OpenCommandPaletteCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+T" Command="{Binding NewLocalTerminalCommand}" CommandParameter="{x:Null}" />
        <KeyBinding Gesture="Ctrl+Shift+W" Command="{Binding Workspace.CloseActiveCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+D" Command="{Binding SplitRightCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+E" Command="{Binding SplitDownCommand}" />
        <KeyBinding Gesture="Ctrl+Tab" Command="{Binding Workspace.NextTabCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+Tab" Command="{Binding Workspace.PreviousTabCommand}" />
        
        <KeyBinding Gesture="Ctrl+Shift+N" Command="{Binding Hosts.NewHostCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+K" Command="{Binding QuickConnectCommand}" />
        <KeyBinding Gesture="Ctrl+OemComma" Command="{Binding OpenSettingsCommand}" />
    </Window.KeyBindings>

    <Window.Styles>
        <!-- Close buttons on tabs only show for the hovered or active tab. -->
        <Style Selector="ListBoxItem Button.tabClose">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="ListBoxItem:selected Button.tabClose, ListBoxItem:pointerover Button.tabClose">
            <Setter Property="Opacity" Value="1" />
        </Style>

        <Style Selector="Border.dialogCard">
            <Style.Animations>
                <Animation Duration="0:0:0.16" Easing="CubicEaseOut" FillMode="Forward">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="Margin" Value="0,10,0,0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1" />
                        <Setter Property="Margin" Value="0" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="Ellipse.statusDot">
            <Setter Property="Fill" Value="{DynamicResource Brush.Text.Tertiary}" />
        </Style>
        <Style Selector="Ellipse.statusDot.busy">
            <Setter Property="Fill" Value="{DynamicResource Brush.Warning}" />
        </Style>
        <Style Selector="Ellipse.statusDot.ok">
            <Setter Property="Fill" Value="{DynamicResource Brush.Success}" />
        </Style>
        <Style Selector="Ellipse.statusDot.error">
            <Setter Property="Fill" Value="{DynamicResource Brush.Danger}" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="*,Auto">
        <Grid ColumnDefinitions="Auto,Auto,Auto,*">

            <!-- Activity rail -->
            <Border Grid.Column="0"
                    Width="{StaticResource Size.Rail}"
                    Background="{DynamicResource Brush.Chrome}"
                    BorderBrush="{DynamicResource Brush.Separator}"
                    BorderThickness="{StaticResource Line.Right}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Spacing="4" Margin="0,0,0,10" HorizontalAlignment="Center">
                        <Button Theme="{StaticResource RailButton}"
                                Command="{Binding ToggleVaultCommand}"
                                ToolTip.Tip="{Binding VaultTooltip}"
                                ToolTip.Placement="Right">
                            <Panel>
                                <c:Icon Size="18" Data="{StaticResource Icon.LockOpen}" IsVisible="{Binding IsVaultUnlocked}" />
                                <c:Icon Size="18" Data="{StaticResource Icon.Lock}" IsVisible="{Binding !IsVaultUnlocked}" />
                            </Panel>
                        </Button>
                        <Button Theme="{StaticResource RailButton}"
                                Command="{Binding OpenSettingsCommand}"
                                ToolTip.Tip="Settings (Ctrl+,)"
                                ToolTip.Placement="Right">
                            <c:Icon Size="18" Data="{StaticResource Icon.Settings}" />
                        </Button>
                        <Button Theme="{StaticResource RailButton}"
                                Command="{Binding CycleThemeCommand}"
                                ToolTip.Tip="{Binding ThemeLabel, StringFormat='Theme: {0}'}"
                                ToolTip.Placement="Right">
                            <c:Icon Size="18" Data="{Binding ThemeIcon, Converter={x:Static conv:IconConverter.Instance}}" />
                        </Button>
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding Sections}" Margin="0,10,0,0" HorizontalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="sidebar:SidebarSectionViewModel">
                                <Button Theme="{StaticResource RailButton}"
                                        Classes.selected="{Binding IsSelected}"
                                        Command="{Binding $parent[ItemsControl].((vm:ShellViewModel)DataContext).ActivateSectionCommand}"
                                        CommandParameter="{Binding}"
                                        ToolTip.Tip="{Binding Title}"
                                        AutomationProperties.Name="{Binding Title}"
                                        ToolTip.Placement="Right">
                                    <c:Icon Size="18" Data="{Binding Icon, Converter={x:Static conv:IconConverter.Instance}}" />
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>

            <!-- Sidebar -->
            <Border Grid.Column="1"
                    IsVisible="{Binding IsSidebarOpen}"
                    Width="{Binding SidebarWidth}"
                    Background="{DynamicResource Brush.Sidebar}">
                <ContentControl Content="{Binding SelectedSection}" />
            </Border>
            <c:ResizeHandle Grid.Column="2"
                            Theme="{StaticResource VerticalResizeHandle}"
                            IsVisible="{Binding IsSidebarOpen}"
                            Value="{Binding SidebarWidth}"
                            Minimum="{Binding SidebarMinWidth}"
                            Maximum="{Binding SidebarMaxWidth}" />

            <!-- Main area -->
            <Grid Grid.Column="3" RowDefinitions="Auto,*,Auto,Auto">

                <!-- Tab strip -->
                <Border Grid.Row="0"
                        Height="{StaticResource Size.TabStrip}"
                        Background="{DynamicResource Brush.Chrome}"
                        BorderBrush="{DynamicResource Brush.Separator}"
                        BorderThickness="{StaticResource Line.Bottom}">
                    <DockPanel Margin="6,0,6,0">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                            <Button Theme="{StaticResource IconButton}"
                                    Command="{Binding ToggleRecordingForActiveCommand}"
                                    IsVisible="{Binding $self.IsEffectivelyEnabled}"
                                    ToolTip.Tip="Record this session to a log file">
                                <Panel>
                                    <c:Icon Data="{StaticResource Icon.CircleDot}" IsVisible="{Binding !IsActiveRecording}" />
                                    <c:Icon Data="{StaticResource Icon.CircleStop}" Foreground="{DynamicResource Brush.Danger}"
                                            IsVisible="{Binding IsActiveRecording}" />
                                </Panel>
                            </Button>
                            <ToggleButton Theme="{StaticResource IconToggleButton}"
                                          IsVisible="{Binding ActiveSplit, Converter={x:Static ObjectConverters.IsNotNull}}"
                                          IsChecked="{Binding ActiveSplit.IsBroadcast, FallbackValue=False}"
                                          ToolTip.Tip="Broadcast typing to all panes in this tab">
                                <c:Icon Data="{StaticResource Icon.RadioTower}" />
                            </ToggleButton>
                            <Button Theme="{StaticResource IconButton}"
                                    Command="{Binding SplitRightCommand}"
                                    IsVisible="{Binding $self.IsEffectivelyEnabled}"
                                    ToolTip.Tip="Split right: another session to this host (Ctrl+Shift+D)">
                                <c:Icon Data="{StaticResource Icon.Columns2}" />
                            </Button>
                            <Button Theme="{StaticResource IconButton}"
                                    Command="{Binding OpenSftpForActiveCommand}"
                                    IsVisible="{Binding $self.IsEffectivelyEnabled}"
                                    AutomationProperties.Name="Browse files"
                                    ToolTip.Tip="Browse files on this host (SFTP)">
                                <c:Icon Data="{StaticResource Icon.FolderTree}" />
                            </Button>
                            <Button Theme="{StaticResource IconButton}"
                                    IsVisible="{Binding HasLocalShells}"
                                    ToolTip.Tip="New local terminal (Ctrl+Shift+T)">
                                <c:Icon Data="{StaticResource Icon.Terminal}" />
                                <Button.Flyout>
                                    <Flyout Placement="BottomEdgeAlignedRight">
                                        <ItemsControl ItemsSource="{Binding LocalShells}" MinWidth="200">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="terminal:LocalShellProfile">
                                                    <Button Theme="{StaticResource GhostButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                            Padding="10,6"
                                                            Command="{Binding $parent[ItemsControl].((vm:ShellViewModel)DataContext).NewLocalTerminalCommand, FallbackValue={x:Null}}"
                                                            CommandParameter="{Binding}">
                                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                                            <c:Icon Size="14" Classes="secondary" Data="{StaticResource Icon.Terminal}" />
                                                            <TextBlock Text="{Binding Name}" />
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                            <Button Theme="{StaticResource IconButton}" ToolTip.Tip="Layouts">
                                <c:Icon Data="{StaticResource Icon.Columns2}" />
                                <Button.Flyout>
                                    <Flyout Placement="BottomEdgeAlignedRight">
                                        <StackPanel MinWidth="220" Spacing="2">
                                            <ItemsControl ItemsSource="{Binding Layouts}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="settings:SavedLayout">
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <Button Theme="{StaticResource GhostButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                                    Padding="10,6"
                                                                    Command="{Binding $parent[ItemsControl].((vm:ShellViewModel)DataContext).OpenLayoutCommand, FallbackValue={x:Null}}"
                                                                    CommandParameter="{Binding}">
                                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                                    <c:Icon Size="14" Classes="secondary" Data="{StaticResource Icon.Columns2}" />
                                                                    <TextBlock Text="{Binding Name}" />
                                                                </StackPanel>
                                                            </Button>
                                                            <Button Grid.Column="1" Theme="{StaticResource GhostButton}" Padding="6" ToolTip.Tip="Delete layout"
                                                                    Command="{Binding $parent[ItemsControl].((vm:ShellViewModel)DataContext).DeleteLayoutCommand, FallbackValue={x:Null}}"
                                                                    CommandParameter="{Binding}">
                                                                <c:Icon Size="12" StrokeThickness="2.2" Data="{StaticResource Icon.X}" />
                                                            </Button>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Classes="hint" Margin="10,6" IsVisible="{Binding !HasLayouts}" TextWrapping="Wrap" MaxWidth="240"
                                                       Text="Save the open tabs and splits to reopen them in one click." />
                                            <Border Classes="hline" Margin="0,4" />
                                            <Button Theme="{StaticResource GhostButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                    Padding="10,6" Content="Save open tabs as a layout…" Command="{Binding SaveLayoutCommand}" />
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                            <Button Theme="{StaticResource IconButton}"
                                    Command="{Binding OpenCommandPaletteCommand}"
                                    ToolTip.Tip="Command palette (Ctrl+Shift+P)">
                                <c:Icon Data="{StaticResource Icon.Command}" />
                            </Button>
                            <Button Theme="{StaticResource IconButton}"
                                    Command="{Binding QuickConnectCommand}"
                                    ToolTip.Tip="Quick connect (Ctrl+Shift+K)">
                                <c:Icon Data="{StaticResource Icon.Zap}" />
                            </Button>
                            <Button Theme="{StaticResource IconButton}"
                                    Command="{Binding ToggleBottomPanelCommand}"
                                    ToolTip.Tip="Toggle panel (Ctrl+Shift+J)">
                                <c:Icon Data="{StaticResource Icon.PanelBottom}" />
                            </Button>
                        </StackPanel>

                        <ListBox Theme="{StaticResource PlainListBox}"
                                 ItemsSource="{Binding Workspace.Tabs}"
                                 SelectedItem="{Binding Workspace.ActiveTab}"
                                 ItemContainerTheme="{StaticResource DocumentTab}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="tabs:TabViewModel">
                                    <DockPanel ToolTip.Tip="{Binding Subtitle}" Background="Transparent">
                                        <DockPanel.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Close" InputGesture="Ctrl+Shift+W"
                                                          Command="{Binding $parent[Window].((vm:ShellViewModel)DataContext).Workspace.CloseTabCommand, FallbackValue={x:Null}}"
                                                          CommandParameter="{Binding}" />
                                                <MenuItem Header="Close other tabs"
                                                          Command="{Binding $parent[Window].((vm:ShellViewModel)DataContext).Workspace.CloseOtherTabsCommand, FallbackValue={x:Null}}"
                                                          CommandParameter="{Binding}" />
                                            </ContextMenu>
                                        </DockPanel.ContextMenu>
                                        <Button DockPanel.Dock="Right"
                                                Classes="tabClose"
                                                Theme="{StaticResource IconButton}"
                                                Width="20" Height="20"
                                                Margin="6,0,0,0"
                                                IsVisible="{Binding CanClose}"
                                                Command="{Binding $parent[ListBox].((vm:ShellViewModel)DataContext).Workspace.CloseTabCommand}"
                                                CommandParameter="{Binding}">
                                            <c:Icon Size="12" StrokeThickness="2.2" Data="{StaticResource Icon.X}" />
                                        </Button>
                                        <c:Icon Size="14"
                                                Margin="0,0,8,0"
                                                Data="{Binding Icon, Converter={x:Static conv:IconConverter.Instance}}" />
                                        <Ellipse DockPanel.Dock="Right" Width="7" Height="7" Margin="6,0,0,0" VerticalAlignment="Center"
                                                 Fill="{DynamicResource Brush.Danger}" IsVisible="{Binding IsRecording}"
                                                 ToolTip.Tip="Recording" />
                                        <Ellipse DockPanel.Dock="Right" Width="7" Height="7" Margin="6,0,0,0" VerticalAlignment="Center"
                                                 Fill="{DynamicResource Brush.Accent}" IsVisible="{Binding HasAlert}"
                                                 ToolTip.Tip="Something happened in this tab" />
                                        <TextBlock Text="{Binding Title}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- Documents: every tab view stays alive, only the active one is visible. -->
                <Panel Grid.Row="1">
                    <ItemsControl ItemsSource="{Binding Workspace.Tabs}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Panel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="tabs:TabViewModel">
                                <ContentControl Content="{Binding}" IsVisible="{Binding IsActive}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel IsVisible="{Binding Workspace.Tabs.Count, Converter={x:Static conv:AppConverters.IsZero}}"
                                HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                        <c:Icon Classes="tertiary" Size="32" StrokeThickness="1.4" Data="{StaticResource Icon.SquareTerminal}" />
                        <TextBlock Classes="secondary" HorizontalAlignment="Center" Text="No open tabs" />
                        <TextBlock Classes="caption" HorizontalAlignment="Center" Text="Pick a host from the sidebar to connect" />
                    </StackPanel>
                </Panel>

                <!-- Bottom panel -->
                <c:ResizeHandle Grid.Row="2"
                                Theme="{StaticResource HorizontalResizeHandle}"
                                IsInverted="True"
                                IsVisible="{Binding IsBottomPanelOpen}"
                                Value="{Binding BottomPanelHeight}"
                                Minimum="{Binding BottomPanelMinHeight}"
                                Maximum="{Binding BottomPanelMaxHeight}" />
                <Border Grid.Row="3"
                        IsVisible="{Binding IsBottomPanelOpen}"
                        Height="{Binding BottomPanelHeight}"
                        Background="{DynamicResource Brush.Window}">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Height="38" Padding="10,0,6,0">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                    <Button Theme="{StaticResource GhostButton}" Padding="8,2" MinHeight="24"
                                            IsVisible="{Binding BottomPanel.IsTransfersPage}"
                                            IsEnabled="{Binding BottomPanel.HasFinished}"
                                            Command="{Binding BottomPanel.ClearFinishedCommand}">
                                        <TextBlock Classes="small secondary" Text="Clear finished" />
                                    </Button>
                                    <Button Theme="{StaticResource GhostButton}" Padding="8,2" MinHeight="24"
                                            IsVisible="{Binding BottomPanel.IsTunnelsPage}"
                                            Command="{Binding BottomPanel.Tunnels.AddCommand}"
                                            ToolTip.Tip="{Binding BottomPanel.Tunnels.AddHint}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <c:Icon Size="13" Data="{StaticResource Icon.Plus}" />
                                            <TextBlock Classes="small" Text="New tunnel" />
                                        </StackPanel>
                                    </Button>
                                    <ComboBox IsVisible="{Binding BottomPanel.IsActivityPage}" ItemsSource="{Binding BottomPanel.Activity.Hosts}"
                                              SelectedItem="{Binding BottomPanel.Activity.SelectedHost}" MinHeight="26" Height="26" MinWidth="120" />
                                    <ComboBox IsVisible="{Binding BottomPanel.IsActivityPage}" ItemsSource="{Binding BottomPanel.Activity.Categories}"
                                              SelectedItem="{Binding BottomPanel.Activity.SelectedCategory}" MinHeight="26" Height="26" MinWidth="120">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate DataType="vm:ActivityFilterOption">
                                                <TextBlock Text="{Binding Name}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Button Theme="{StaticResource GhostButton}" Padding="8,2" MinHeight="24"
                                            IsVisible="{Binding BottomPanel.IsActivityPage}"
                                            Command="{Binding BottomPanel.Activity.ClearCommand}">
                                        <TextBlock Classes="small secondary" Text="Clear" />
                                    </Button>
                                    <Button Theme="{StaticResource IconButton}"
                                            Command="{Binding ToggleBottomPanelCommand}"
                                            ToolTip.Tip="Close panel">
                                        <c:Icon Size="14" Data="{StaticResource Icon.X}" />
                                    </Button>
                                </StackPanel>
                                <Border Classes="segmented" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Theme="{StaticResource SegmentItem}" GroupName="bottomPage"
                                                     IsChecked="{Binding BottomPanel.IsTransfersPage}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="Transfers" />
                                                <Border Classes="badge" IsVisible="{Binding BottomPanel.ActiveCount, Converter={x:Static conv:AppConverters.IsNotZero}}">
                                                    <TextBlock Classes="caption" HorizontalAlignment="Center" Text="{Binding BottomPanel.ActiveCount}" />
                                                </Border>
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton Theme="{StaticResource SegmentItem}" GroupName="bottomPage"
                                                     IsChecked="{Binding BottomPanel.IsTunnelsPage}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="Tunnels" />
                                                <Border Classes="badge" IsVisible="{Binding BottomPanel.Tunnels.ActiveCount, Converter={x:Static conv:AppConverters.IsNotZero}}">
                                                    <TextBlock Classes="caption" HorizontalAlignment="Center" Text="{Binding BottomPanel.Tunnels.ActiveCount}" />
                                                </Border>
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton Theme="{StaticResource SegmentItem}" GroupName="bottomPage"
                                                     IsChecked="{Binding BottomPanel.IsActivityPage}" Content="Activity" />
                                    </StackPanel>
                                </Border>
                            </DockPanel>
                        </Border>
                        <Panel>
                            <!-- Tunnels -->
                            <Panel IsVisible="{Binding BottomPanel.IsTunnelsPage}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4"
                                            IsVisible="{Binding !BottomPanel.Tunnels.HasTunnels}">
                                    <TextBlock Classes="caption" HorizontalAlignment="Center" Text="No tunnels in open sessions" />
                                    <TextBlock Classes="caption" HorizontalAlignment="Center"
                                               Text="Add port forwards in the host editor, or with New tunnel for the current session" />
                                </StackPanel>
                                <ListBox Theme="{StaticResource PlainListBox}" ItemsSource="{Binding BottomPanel.Tunnels.Items}"
                                         ItemContainerTheme="{StaticResource SidebarListItem}" Padding="0,0,0,6">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="tun:TunnelViewModel">
                                            <Grid ColumnDefinitions="Auto,*,Auto" Height="44">
                                                <Border Grid.Column="0" Width="28" Height="28" CornerRadius="{StaticResource Radius.Md}"
                                                        Background="{DynamicResource Brush.Fill.Selected}" Margin="0,0,12,0" VerticalAlignment="Center">
                                                    <c:Icon Classes="secondary" Size="14" Data="{StaticResource Icon.ArrowLeftRight}" />
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <Ellipse Classes="statusDot" Width="7" Height="7" VerticalAlignment="Center"
                                                                 Classes.ok="{Binding IsActive}" Classes.error="{Binding IsFailed}" />
                                                        <TextBlock Classes="mono" FontWeight="Medium" Text="{Binding Description}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="15,0,0,0">
                                                        <TextBlock Classes="caption" Text="{Binding KindLabel}" />
                                                        <TextBlock Classes="caption" Text="·" />
                                                        <TextBlock Classes="caption" Text="{Binding HostName}" />
                                                        <TextBlock Classes="caption" Text="·" />
                                                        <TextBlock Classes="caption" Classes.danger="{Binding IsFailed}" Text="{Binding Detail}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                                                    <Button Theme="{StaticResource IconButton}" IsVisible="{Binding !IsActive}"
                                                            Command="{Binding StartCommand}" ToolTip.Tip="Start tunnel">
                                                        <c:Icon Size="14" Data="{StaticResource Icon.Play}" />
                                                    </Button>
                                                    <Button Theme="{StaticResource IconButton}" IsVisible="{Binding IsActive}"
                                                            Command="{Binding StopCommand}" ToolTip.Tip="Stop tunnel">
                                                        <c:Icon Size="14" Data="{StaticResource Icon.Pause}" />
                                                    </Button>
                                                    <Button Theme="{StaticResource IconButton}" IsVisible="{Binding IsTemporary}"
                                                            Command="{Binding $parent[Window].((vm:ShellViewModel)DataContext).BottomPanel.Tunnels.RemoveCommand}"
                                                            CommandParameter="{Binding}" ToolTip.Tip="Remove tunnel">
                                                        <c:Icon Size="14" Data="{StaticResource Icon.X}" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Panel>

                            <!-- Activity -->
                            <Panel IsVisible="{Binding BottomPanel.IsActivityPage}">
                                <TextBlock Classes="caption" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           IsVisible="{Binding !BottomPanel.Activity.HasItems}"
                                           Text="Connections, logins, host keys, transfers and tunnels will appear here" />
                                <ListBox Theme="{StaticResource PlainListBox}" ItemsSource="{Binding BottomPanel.Activity.Items}"
                                         ItemContainerTheme="{StaticResource SidebarListItem}" Padding="0,0,0,6">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="vm:ActivityItemViewModel">
                                            <Grid ColumnDefinitions="Auto,150,140,*" Height="30" ToolTip.Tip="{Binding Message}">
                                                <c:Icon Grid.Column="0" Classes="tertiary" Classes.danger="{Binding IsProblem}" Size="13" Margin="0,0,12,0"
                                                        Data="{Binding Icon, Converter={x:Static conv:IconConverter.Instance}}" />
                                                <TextBlock Grid.Column="1" Classes="caption mono" VerticalAlignment="Center" Text="{Binding Time}" />
                                                <TextBlock Grid.Column="2" Classes="small" FontWeight="Medium" VerticalAlignment="Center"
                                                           Text="{Binding Host}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="3" Classes="small secondary" Classes.danger="{Binding IsProblem}" VerticalAlignment="Center"
                                                           Text="{Binding Message}" TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Panel>

                            <!-- Transfers -->
                            <Panel IsVisible="{Binding BottomPanel.IsTransfersPage}">
                            <TextBlock Classes="caption" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       IsVisible="{Binding !BottomPanel.HasTransfers}"
                                       Text="Uploads and downloads will appear here" />
                            <ListBox Theme="{StaticResource PlainListBox}" ItemsSource="{Binding BottomPanel.Transfers}"
                                     ItemContainerTheme="{StaticResource SidebarListItem}" Padding="0,0,0,6">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="vm:TransferItemViewModel">
                                        <Grid ColumnDefinitions="Auto,*,Auto" Height="46">
                                            <Border Grid.Column="0" Width="28" Height="28" CornerRadius="{StaticResource Radius.Md}"
                                                    Background="{DynamicResource Brush.Fill.Selected}" Margin="0,0,12,0" VerticalAlignment="Center">
                                                <c:Icon Classes="secondary" Size="14" Data="{Binding Icon, Converter={x:Static conv:IconConverter.Instance}}" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="5">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Classes="caption" Margin="12,0,0,0"
                                                               Classes.danger="{Binding IsFailed}" Text="{Binding Detail}" />
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock FontWeight="Medium" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Classes="caption" VerticalAlignment="Center" Text="{Binding Route}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </DockPanel>
                                                <ProgressBar Value="{Binding Progress}" Maximum="100" IsVisible="{Binding IsActive}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                                                <Button Theme="{StaticResource IconButton}" IsVisible="{Binding IsActive}"
                                                        Command="{Binding CancelCommand}" ToolTip.Tip="Cancel">
                                                    <c:Icon Size="14" Data="{StaticResource Icon.X}" />
                                                </Button>
                                                <Button Theme="{StaticResource IconButton}" IsVisible="{Binding CanRetry}"
                                                        Command="{Binding RetryCommand}" ToolTip.Tip="Retry (resumes where it stopped)">
                                                    <c:Icon Size="14" Data="{StaticResource Icon.RotateCcw}" />
                                                </Button>
                                                <Button Theme="{StaticResource IconButton}" IsVisible="{Binding CanReveal}"
                                                        Command="{Binding RevealCommand}" ToolTip.Tip="Show in folder">
                                                    <c:Icon Size="14" Data="{StaticResource Icon.FolderOpen}" />
                                                </Button>
                                                <c:Icon Classes="tertiary" Size="14" Margin="7,0" IsVisible="{Binding IsCompleted}"
                                                        Data="{StaticResource Icon.CircleCheck}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            </Panel>
                        </Panel>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="1"
                Height="{StaticResource Size.StatusBar}"
                Background="{DynamicResource Brush.Chrome}"
                BorderBrush="{DynamicResource Brush.Separator}"
                BorderThickness="{StaticResource Line.Top}"
                Padding="12,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right"
                           Classes="caption"
                           VerticalAlignment="Center"
                           Text="{Binding Workspace.ActiveTab.StatusDetail, FallbackValue={x:Null}}" />
                <Button DockPanel.Dock="Right" Theme="{StaticResource GhostButton}" Padding="6,0" Margin="0,0,16,0"
                        VerticalAlignment="Center" IsVisible="{Binding Updates.IsUpdateAvailable}"
                        Command="{Binding OpenUpdateCommand}" ToolTip.Tip="Open the release page">
                    <TextBlock Classes="caption" Foreground="{DynamicResource Brush.Accent}" Text="{Binding Updates.UpdateText}" />
                </Button>
                <TextBlock DockPanel.Dock="Right"
                           Classes="caption"
                           Margin="0,0,24,0"
                           VerticalAlignment="Center"
                           IsVisible="{Binding Workspace.ActiveTab.ServerStats, Converter={x:Static StringConverters.IsNotNullOrEmpty}, FallbackValue=False}"
                           Text="{Binding Workspace.ActiveTab.ServerStats, FallbackValue={x:Null}}" />
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Ellipse Classes="statusDot"
                             Classes.busy="{Binding StatusBar.IsBusy}"
                             Classes.ok="{Binding StatusBar.IsOk}"
                             Classes.error="{Binding StatusBar.IsError}"
                             Width="7" Height="7" />
                    <TextBlock Classes="secondary small" Text="{Binding StatusBar.Message}" />
                </StackPanel>
            </DockPanel>
        </Border>
        <!-- Command palette -->
        <Panel Grid.RowSpan="2" IsVisible="{Binding CommandPalette.IsOpen}">
            <Border Background="{DynamicResource Brush.Overlay}" Opacity="0.5"
                    b:InputBehaviors.TapCommand="{Binding CommandPalette.CloseCommand}" />
            <Border Width="620" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="24,72,24,24"
                    Background="{DynamicResource Brush.Surface}"
                    CornerRadius="{StaticResource Radius.Lg}"
                    BoxShadow="{DynamicResource Shadow.Dialog}"
                    ClipToBounds="True">
                <DockPanel>
                    <TextBox DockPanel.Dock="Top" Classes="palette"
                             PlaceholderText="Search hosts, snippets, commands and actions"
                             Text="{Binding CommandPalette.Query}"
                             b:InputBehaviors.FocusTrigger="{Binding CommandPalette.FocusRequest}">
                        <TextBox.InnerLeftContent>
                            <c:Icon Size="16" Margin="14,0,4,0" Classes="tertiary" Data="{StaticResource Icon.Search}" />
                        </TextBox.InnerLeftContent>
                        <TextBox.KeyBindings>
                            <KeyBinding Gesture="Down" Command="{Binding CommandPalette.MoveDownCommand}" />
                            <KeyBinding Gesture="Up" Command="{Binding CommandPalette.MoveUpCommand}" />
                            <KeyBinding Gesture="Enter" Command="{Binding CommandPalette.RunCommand}" />
                            <KeyBinding Gesture="Ctrl+Enter" Command="{Binding CommandPalette.RunAlternateCommand}" />
                            <KeyBinding Gesture="Escape" Command="{Binding CommandPalette.CloseCommand}" />
                        </TextBox.KeyBindings>
                    </TextBox>
                    <Border DockPanel.Dock="Top" Classes="hline" />
                    <TextBlock DockPanel.Dock="Bottom" Classes="caption" Margin="16,8,16,10" Text="{Binding CommandPalette.Hint}" />
                    <Border DockPanel.Dock="Bottom" Classes="hline" />
                    <Panel>
                        <TextBlock Classes="secondary" Margin="16,18" IsVisible="{Binding CommandPalette.HasNoResults}" Text="No matches" />
                        <ListBox Theme="{StaticResource PlainListBox}" MaxHeight="420" Padding="6"
                                 ItemsSource="{Binding CommandPalette.Items}"
                                 SelectedItem="{Binding CommandPalette.SelectedItem}">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="vm:PaletteItem">
                                    <DockPanel Background="Transparent" Margin="4,3"
                                               b:InputBehaviors.TapCommand="{Binding $parent[Window].((vm:ShellViewModel)DataContext).CommandPalette.RunCommand, FallbackValue={x:Null}}"
                                               b:InputBehaviors.DoubleTapCommandParameter="{Binding}">
                                        <TextBlock DockPanel.Dock="Right" Classes="caption" VerticalAlignment="Center" Margin="12,0,4,0"
                                                   Text="{Binding Shortcut}" FontFamily="{StaticResource Font.Mono}"
                                                   IsVisible="{Binding Shortcut, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                        <TextBlock DockPanel.Dock="Right" Classes="caption" VerticalAlignment="Center" Margin="12,0,4,0"
                                                   Text="{Binding Category}"
                                                   IsVisible="{Binding Shortcut, Converter={x:Static ObjectConverters.IsNull}}" />
                                        <c:Icon Size="15" Margin="0,0,12,0" Classes="secondary" VerticalAlignment="Center"
                                                Data="{Binding Icon, Converter={x:Static conv:IconConverter.Instance}}" />
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Classes="caption" Text="{Binding Detail}" TextTrimming="CharacterEllipsis"
                                                       IsVisible="{Binding Detail, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Panel>
                </DockPanel>
            </Border>
        </Panel>

        <!-- Dialog overlay -->
        <Panel Grid.RowSpan="2"
               IsVisible="{Binding Dialogs.HasDialog}"
               Background="{DynamicResource Brush.Overlay}">
            <Panel.KeyBindings>
                <KeyBinding Gesture="Escape" Command="{Binding Dialogs.Current.CancelCommand, FallbackValue={x:Null}}" />
            </Panel.KeyBindings>
            <ContentControl Content="{Binding Dialogs.Current}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="24">
                <ContentControl.ContentTemplate>
                    <DataTemplate DataType="dialogs:DialogViewModel">
                        <Border Classes="dialogCard"
                                Width="{Binding Width}"
                                Background="{DynamicResource Brush.Surface}"
                                CornerRadius="{StaticResource Radius.Lg}"
                                BoxShadow="{DynamicResource Shadow.Dialog}">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="24,20,16,4">
                                    <Button DockPanel.Dock="Right"
                                            Theme="{StaticResource IconButton}"
                                            VerticalAlignment="Top"
                                            Command="{Binding CancelCommand}"
                                            ToolTip.Tip="Close (Esc)">
                                        <c:Icon Size="14" Data="{StaticResource Icon.X}" />
                                    </Button>
                                    <TextBlock Classes="title" VerticalAlignment="Center" Text="{Binding Title}" />
                                </DockPanel>
                                <ContentControl Content="{Binding}" />
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>
        </Panel>
    </Grid>
</Window>
