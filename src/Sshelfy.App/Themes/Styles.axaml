<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:Sshelfy.App.Controls">
    <!--
        Global styles layered on top of FluentTheme. They only map Fluent controls onto
        our tokens; component-specific looks live in ControlThemes/*.axaml.
    -->

    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource Brush.Window}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
    </Style>

    <!-- Typography -->
    <Style Selector="TextBlock.caption">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Tertiary}" />
    </Style>
    <Style Selector="TextBlock.secondary">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
    </Style>
    <Style Selector="TextBlock.tertiary">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Tertiary}" />
    </Style>
    <Style Selector="TextBlock.small">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Small}" />
    </Style>
    <Style Selector="TextBlock.section">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
    </Style>
    <Style Selector="TextBlock.title">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Title}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.heading">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Heading}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.display">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Display}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.mono">
        <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
    </Style>
    <Style Selector="TextBlock.danger">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
    </Style>

    <Style Selector="c|Icon.secondary">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
    </Style>
    <Style Selector="c|Icon.tertiary">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Tertiary}" />
    </Style>
    <Style Selector="c|Icon.danger">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
    </Style>
    <Style Selector="c|Icon.accent">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Text}" />
    </Style>

    <!-- Segmented control container -->
    <Style Selector="Border.segmented">
        <Setter Property="Background" Value="{DynamicResource Brush.Fill.Selected}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <!-- Form field label -->
    <Style Selector="TextBlock.label">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Small}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style Selector="TextBlock.hint">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Small}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Tertiary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.error">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Small}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Small count badge -->
    <Style Selector="Border.badge">
        <Setter Property="Background" Value="{DynamicResource Brush.Fill.Selected}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="MinWidth" Value="18" />
        <Setter Property="Height" Value="16" />
    </Style>

    <!-- Separators -->
    <Style Selector="Border.hline">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource Brush.Separator}" />
    </Style>
    <Style Selector="Border.vline">
        <Setter Property="Width" Value="1" />
        <Setter Property="Background" Value="{DynamicResource Brush.Separator}" />
    </Style>

    <!-- Text input: flat field, accent outline on focus (overrides Fluent's underline). -->
    <Style Selector="TextBox">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="PlaceholderForeground" Value="{DynamicResource Brush.Text.Tertiary}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Brush.Accent.Subtle}" />
        <Setter Property="SelectionForegroundBrush" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="{StaticResource Pad.Control}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource Brush.Input}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Md}" />
    </Style>
    <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource Brush.Input}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
    </Style>
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource Brush.Input}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderFocus}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="TextBox:error /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}" />
    </Style>

    <!-- Search field: no border, sunken fill. -->
    <Style Selector="TextBox.search /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource Brush.Fill.Selected}" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="TextBox.search:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource Brush.Fill.Pressed}" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="TextBox.search:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource Brush.Input}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderFocus}" />
    </Style>
    <!-- Command palette field: large, borderless, part of the card. -->
    <Style Selector="TextBox.palette">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Title}" />
        <Setter Property="MinHeight" Value="52" />
        <Setter Property="Padding" Value="4,0,16,0" />
    </Style>
    <Style Selector="TextBox.palette /template/ Border#PART_BorderElement, TextBox.palette:pointerover /template/ Border#PART_BorderElement, TextBox.palette:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>

    <Style Selector="TextBox.search">
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="4,4,8,4" />
    </Style>

    <!--
        Keyboard focus: a soft accent ring instead of Fluent's high-contrast white frame.
        Text fields already show focus through their border, so they get no adorner at all.
    -->
    <Style Selector="Button, ToggleButton, RadioButton, CheckBox, ToggleSwitch, ListBoxItem, TreeViewItem">
        <Setter Property="FocusAdorner">
            <FocusAdornerTemplate>
                <Border BorderBrush="{DynamicResource Brush.BorderFocus}" BorderThickness="2"
                        CornerRadius="{StaticResource Radius.Md}" Margin="-2" Opacity="0.7" />
            </FocusAdornerTemplate>
        </Setter>
    </Style>
    <Style Selector="TextBox, NumericUpDown, ComboBox">
        <Setter Property="FocusAdorner" Value="{x:Null}" />
    </Style>

    <Style Selector="NumericUpDown">
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Md}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Input}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="NumericUpDown /template/ TextBox">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="NumericUpDown /template/ TextBox /template/ Border#PART_BorderElement">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="NumericUpDown /template/ ButtonSpinner RepeatButton">
        <Setter Property="MinWidth" Value="22" />
        <Setter Property="Width" Value="22" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
    </Style>

    <!-- ComboBox / NumericUpDown share the field look. -->
    <Style Selector="ComboBox">
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Md}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Input}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
    </Style>

    <!-- Popups and menus -->
    <Style Selector="ContextMenu">
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Lg}" />
        <Setter Property="Padding" Value="4" />
    </Style>
    <Style Selector="MenuItem">
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Sm}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="Padding" Value="10,5" />
    </Style>
    <Style Selector="ToolTip">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Small}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Md}" />
        <Setter Property="Padding" Value="8,4" />
    </Style>

    <Style Selector="ProgressBar">
        <Setter Property="MinHeight" Value="4" />
        <Setter Property="Height" Value="4" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Background" Value="{DynamicResource Brush.Fill.Pressed}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
    </Style>
</Styles>
